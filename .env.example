# Copiar a .env.local para desarrollo, o cargar en Vercel → Settings → Environment Variables.
# Vacío = integración pendiente (la página funciona y muestra alternativas honestas).
# Verificar que cada ID pertenezca a la cuenta de ESTA campaña (Daniel Barrios / Gabriel García),
# no a la primera landing de Marisol Caro.

# ---------- Públicas (terminan en el JavaScript del navegador) ----------
# 'demo' muestra el aviso "Versión de prueba". Cambiar a 'live' solo después de la prueba integral.
VITE_FUNNEL_MODE=demo
# Dominio o subdominio definitivo, sin barra final (ej. https://invertirenmerida.com)
VITE_SITE_URL=
# URL del widget de reserva del calendario de GHL de esta campaña
VITE_GHL_CALENDAR_URL=
# WhatsApp de contacto de la campaña: solo dígitos con lada (ej. 5299XXXXXXXX)
VITE_WHATSAPP_NUMBER=
# Google Analytics 4 (G-XXXXXXX)
VITE_GA4_ID=
# Meta Pixel ID (solo números)
VITE_META_PIXEL_ID=
# Opcional: VSL alojado fuera del proyecto (para VTurb usar src/vsl-embed.js)
VITE_VSL_MP4_URL=
# Opcional: aviso de privacidad externo
VITE_PRIVACY_URL=

# ---------- Privadas (solo servidor, /api). NUNCA con prefijo VITE_ ----------
# Inbound Webhook del workflow de GHL que crea/actualiza el contacto y la oportunidad
GHL_WEBHOOK_URL=
# Meta Conversions API
META_PIXEL_ID=
META_CAPI_TOKEN=
# Solo durante pruebas en el Administrador de eventos; borrar en producción
META_TEST_EVENT_CODE=
# Opcional (por defecto v21.0)
META_API_VERSION=
